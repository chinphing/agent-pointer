# locate_fixture 手动测试的环境变量。
#
# 用法：
#   cd crates/pointer-core
#   set -a; . tests/locate_fixture/env.example; set +a
#   cargo test --test locate_fixture -- --ignored --nocapture
#
# 或者一条命令内联：
#   POINTER_LOCATE_BASE_URL=... POINTER_LOCATE_API_KEY=... POINTER_LOCATE_MODEL=qwen3.8-flash \
#     cargo test -p pointer-core --test locate_fixture -- --ignored --nocapture

# ── 必填 ────────────────────────────────────────────────────────────────
# 视觉模型端点（OpenAI 兼容）
POINTER_LOCATE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
POINTER_LOCATE_API_KEY=sk-your-key-here
POINTER_LOCATE_MODEL=qwen3.8-flash

# ── 可选 ────────────────────────────────────────────────────────────────
# 只采集坐标、不校验：用于新增样例时生成 truth.json。
# 输出形如 CAPTURE <scene> <description> <box>，把它填进 truth.json 的 bbox。
# POINTER_LOCATE_CAPTURE=1

# 覆盖用户设置文件路径（默认 macOS 的
# ~/Library/Application Support/PointerApp/user_settings.json）。
# 不设 POINTER_LOCATE_BASE_URL 时会回退到该文件里的当前 provider。
# POINTER_USER_SETTINGS=/path/to/user_settings.json
