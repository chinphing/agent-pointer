{
  "name": "pointer-app",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/tauri-build.mjs",
    "server:dev": "cargo run -p pointer-server",
    "server:build": "node scripts/build-server.mjs",
    "server:package": "node scripts/build-server.mjs --package-only",
    "license-gen:dev": "cargo run -p pointer-license-gen --",
    "license-gen:build": "node scripts/build-license-gen.mjs",
    "server:start": "cargo run -p pointer-server --release",
    "server:daemon": "node scripts/pointer-server-process.mjs start",
    "server:stop": "node scripts/pointer-server-process.mjs stop",
    "server:restart": "node scripts/pointer-server-process.mjs restart",
    "server:status": "node scripts/pointer-server-process.mjs status",
    "server:build:deb": "node scripts/build-server.mjs --deb-only",
    "server:build:linux": "npm run server:build",
    "server:deb": "npm run server:build",
    "license-gen:package": "npm run license-gen:build",
    "web:dev": "vite --host 0.0.0.0 --port 1420",
    "icons": "node scripts/generate-app-icons.mjs",
    "build:windows": "npm run tauri:build",
    "build:macos": "npm run tauri:build",
    "build:macos:signed": "node scripts/macos-signed-build.mjs",
    "build:macos:sign-only": "node scripts/macos-signed-build.mjs --sign-only",
    "build:macos:universal": "npm run tauri:build -- --target universal-apple-darwin",
    "signing:macos:setup": "node scripts/macos-signing-setup.mjs",
    "build:linux": "npm run tauri:build",
    "build:linux:appimage": "npm run tauri:build -- --bundles appimage",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@tauri-apps/plugin-updater": "^2.4.0",
    "lucide-vue-next": "^0.460.0",
    "marked": "^14.1.3",
    "pinia": "^2.2.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "sharp": "^0.35.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
