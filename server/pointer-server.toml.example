# Copy to pointer-server.toml beside pointer-server.exe (NOT pointer-server.toml.example).
# OS environment variables override file values (remove NSSM AppEnvironmentExtra if duplicated).
#
# 单实例约束：Web 会话（pointer_web_session）与登录中状态都保存在本进程内存里，
# 没有外置会话存储。同一份配置只能跑一个实例（不要多副本/负载均衡），
# 进程重启会让所有在线会话失效、未完成的登录失效。
# 自检：pointer-server auth doctor [--config <path>] [--network] [--exchange]

# --- Standalone self-hosted deployment (no readflowai.com) ---
# [deployment]
# mode = "standalone"
#
# [auth.local]
# username = "admin"
# hmac_secret = "replace-with-long-random-secret"
# # Generate: pointer-server --hash-password --secret '<hmac_secret>' '<password>'
# password_hmac = "...."
#
# # Third-party SSO: a `token_lookup` provider. The portal opens
# # https://{public_url}/api/auth/callback/portal?ticket=<jwt>
# [auth.providers.portal]
# kind = "token_lookup"
# display_name = "SSO"
# icon = "ticket"              # building / key / ticket / user / shield / globe
#
# [auth.providers.portal.token_lookup]
# ticket_param = "ticket"      # query parameter carrying the ticket
# subject_path = "/sub"        # stable user id claim
# nickname_path = "/name"      # optional display name claim
#
# [auth.providers.portal.token_lookup.signing]
# secret = "replace-with-shared-hmac-secret"
# audience = "https://pointer.example.com"
#
# Models, API keys, and extra_body are configured in 设置 → 模型配置
# (same as the desktop custom-provider editor). Do not put them in this file.
#
# [license]
# key = "BASE64_PAYLOAD.BASE64_SIGNATURE"
# # or: license_file = "license.key"
#
# [usage]
# report_enabled = false

[server]
addr = "0.0.0.0:8787"
static_dir = "dist"
skills_dir = "skills"
# Data dir and logs default to the same paths as the desktop client
# ({data_dir}/PointerApp release, PointerAppDev debug; logs under …/logs/).
# Override data dir only if needed:
# app_data_dir = "/absolute/path"
# Web UI + bundled skills:
# - zip layout: relative `dist` / `skills` beside the binary (or next to this toml)
# - Linux .deb: use absolute FHS paths, e.g.
#   static_dir = "/usr/share/pointer-server/dist"
#   skills_dir = "/usr/share/pointer-server/skills"
# (systemd unit also sets POINTER_SERVER_STATIC_DIR / POINTER_SERVER_SKILLS_DIR)
# Public base URL (no trailing slash) reachable from end-user browsers.
# Used to build the OAuth redirect_uri for the server-side PKCE login flow
# ({public_url}/api/auth/oauth/callback). Also used for IM large-file
# download links: GET /api/media/public-download?token=… (HMAC, no login).
# Add that callback URL to the platform
# env POINTER_APP_REDIRECT_URIS. When omitted, it falls back to
# http://{host}:{port} derived from `addr` — including loopback binds
# (127.0.0.1 / 0.0.0.0 / localhost → http://127.0.0.1:{port}) so local
# development works with zero config. Set this explicitly for production
# behind a public domain or reverse proxy.
# Optional: POINTER_MEDIA_DOWNLOAD_SECRET / POINTER_MEDIA_DOWNLOAD_TTL_SECS
# for signing IM public download tokens (default TTL 7 days).
# public_url = "https://pointer.example.com"
#
# Browser tab title for the served Web UI (`<title>`). Default: Pointer · AI 工作台
# page_title = "Acme · AI 助手"
# Env override: POINTER_SERVER_PAGE_TITLE
#
# Composer empty-state placeholder (logged-in + API key). Default: 告诉我你想做什么
# composer_placeholder = "有什么可以帮你？"
# Env override: POINTER_SERVER_COMPOSER_PLACEHOLDER
#
# Brand-new empty chat tip (optional). Both title and body should be set to show
# the tip; see docs/zh-CN/ui/web-branding-welcome-elapsed.md
# welcome_tip_title = "我是 Acme AI 助手"
# welcome_tip_body = "提交附件后我会自动处理，预计 10–30 分钟，期间您可以离开，完成后回来确认即可。"
# Env: POINTER_SERVER_WELCOME_TIP_TITLE / POINTER_SERVER_WELCOME_TIP_BODY
#
# Turn elapsed chip prefixes (optional). Default both: 工作 →「工作 N m SS s」
# turn_elapsed_active = "任务处理中"
# Turn elapsed chip prefixes (optional). Default both: 工作 →「工作 N m SS s」
# turn_elapsed_active = "任务处理中"
# turn_elapsed_done = "任务已完成"
# Env: POINTER_SERVER_TURN_ELAPSED_ACTIVE / POINTER_SERVER_TURN_ELAPSED_DONE
#
# Brand name shown in sidebar / top bar (like page_title). Default: Pointer
# brand_name = "Acme 助手"
# Env: POINTER_SERVER_BRAND_NAME
#
# Brand icon for top-left and bottom-left (same logo; URL or static path under dist).
# Default: /app-icon.png
# brand_icon = "/branding/logo.png"
# Env: POINTER_SERVER_BRAND_ICON
#
# Desktop snapshot button (left sidebar). Unset = auto-detect displays
# (hidden on headless / non-UI hosts). Set explicitly to force:
# desktop_snapshot_enabled = false
# Env: POINTER_SERVER_DESKTOP_SNAPSHOT_ENABLED
#
# Restrict platform OAuth to specific user ids (platform account id).
# Leave empty to allow any platform user (development / trusted intranet only).
# allowed_user_ids = ["your-platform-user-id"]
# require_allowed_users = true
#
# SSE 首帧 padding（chat_stream 连接建立后立即发送的注释帧）：
# 用于穿透缓冲型防火墙/反向代理，避免 SSE 流长期 (pending) 不落地。
# 默认关闭；需要时显式开启 sse_padding_enabled = true（10KB / 10240 字节），
# 或调大/调小 bytes 匹配防火墙缓冲阈值（实验值，按需调整）。
# sse_padding_enabled = false
# sse_padding_bytes = 10240
# Env override: POINTER_SERVER_SSE_PADDING_ENABLED / POINTER_SERVER_SSE_PADDING_BYTES
#
# Agent `terminal` only: reject command/stdin that contain the literal
# SESSION_USER_ID (blocks common SESSION_USER_ID=… overrides). Default off.
# Desktop client ignores this. Not a hard security boundary.
# forbid_session_user_id_in_terminal = true
# Env override: POINTER_SERVER_FORBID_SESSION_USER_ID_IN_TERMINAL
#
# Browser CORS (default off: same-origin only). Desktop Tauri IPC is unaffected.
# Production UI served from this process is same-origin and does not need CORS.
# Enable only when a browser page on another origin calls this API
# (for example Vite `web:dev` with VITE_WEB_API_BASE=http://127.0.0.1:8787).
# Prefer empty / unset VITE_WEB_API_BASE so Vite proxies /api (same-origin cookies).
# ["*"] mirrors any Origin and allows credentials; a list is an exact match
# (`http://localhost:1420` is not the same origin as `http://127.0.0.1:1420`).
# cors_origins = ["http://localhost:1420"]
# Env override: POINTER_SERVER_CORS_ORIGINS=*  or comma-separated origins
#
# Auth: pointer-server does NOT write auth.dat. Each browser gets its own
# in-memory OAuth session via the HttpOnly cookie `pointer_web_session`.
# Visitors without that cookie see logged-out state. After upgrading, delete
# any legacy auth.dat under the data dir so old global sessions are not reused
# by the desktop-style code path on other entrypoints.
#
# Standalone mode: the Web UI renders one entry per enabled provider from
# `[auth.providers.<id>]` (GET /api/auth/providers). `local_password` shows the
# username/password + captcha form:
#   POST /api/auth/login/start?provider=local_password  → { captcha: { captchaId, imageSvg } }
#   POST /api/auth/login/finish?provider=local_password → { username, password, captchaId, captcha } → session cookie
# A `token_lookup` provider is entered by the portal at
# GET /api/auth/callback/<id>?<ticket_param>=<jwt>.
# Generate password_hmac: pointer-server --hash-password --secret '<hmac_secret>' '<password>'
# SSO: [auth.providers.<id>] kind = "token_lookup" + signing secret/audience;
# mint with --mint-sso-ticket --sub USER_ID
# Deprecated: admin_token is ignored.
#
# 登录入口限流（默认开启；进程内计数，单实例）：
# [auth.rate_limit]
# enabled = true                 # 总开关
# per_ip_per_minute = 20         # 每 IP 每分钟的 login/start 次数；0 = 不限
# max_pending = 256              # 同时在途的登录上限；超限拒绝新请求（不淘汰进行中的）；0 = 不限
# finish_fail_backoff_secs = 3   # login/finish 失败后的冷却秒数；0 = 关闭
# trusted_proxies = ["10.0.0.0/8", "127.0.0.1"]   # 只有来自这些地址的请求才采信 X-Forwarded-For
#
# Conversation history (GET /api/conversations*) requires a logged-in browser
# session. Unauthenticated visitors see an empty sidebar until they sign in.
# The Tauri desktop app is unchanged (local auth.dat + IPC).

[pointer]
# Your control plane. The open-source tree ships no vendor default, so this has
# no fallback: leave it empty for a standalone server.
# api_base = "https://ptr.readflowai.com"
# No shared secret is needed: platform login is a PKCE public client
# (client_id + code_verifier). An old `oauth_client_secret` key is ignored.

# Optional: any additional env vars (KEY=VALUE)
# [env]
# POINTER_API_BASE = "https://ptr.readflowai.com"

# ---------------------------------------------------------------------------
# Execution environment (sandbox tiers). Fully commented out = `local`: agent
# tools run on this host, no sandbox. Uncomment to run them inside one.
#
# RECOMMENDED DEFAULT: `local`. Keep the whole table commented out, or set
# `provider = "local"` explicitly. A half-configured sandbox fails at startup
# or on the first message, so stay on `local` until the sandbox is actually
# needed AND fully set up (image built, backend reachable).
#
# PLATFORM-MODE TRAP: when `provider` is unset the default is derived from
# `[deployment] mode` — standalone derives `local`, but **platform derives
# `headless`**, and `headless` defaults to the `envd` backend, which requires
# `sandbox_url`. A platform deployment with no `[environment]` section
# therefore fails on the first message. Set `provider = "local"` to avoid it.
#
# This table is parsed with `deny_unknown_fields`: a misspelled key
# (`provder` / `bakend` / `sandbox-url`) makes pointer-server FAIL AT STARTUP
# and names the offending key. It is never silently ignored — copy the key
# names below verbatim.
#
# Tier decides whether there is a GUI; backend decides how IO is implemented:
#   local     -> host        (no sandbox)
#   headless  -> envd        (needs sandbox_url) | docker
#   desktop   -> docker      (desktop inside the container)
# The pre-rename values `light` / `container` are NO LONGER accepted: startup
# fails and points at `headless` / `desktop` instead of silently aliasing them.
# ---------------------------------------------------------------------------
# [environment]
# provider = "local"                       # local (recommended default) | headless | desktop
#                                          # leave `local` until the sandbox is built and reachable
# backend  = "docker"                      # host | envd | docker (global default; never applies to `local`)
# sandbox_url = "http://10.0.0.5:3000"     # required when the resolved backend is envd
# template = "pointer-sandbox-desktop:latest"
# desktop = false                          # explicit override only: unset = derived from tier (desktop has a desktop).
#                                          # A value that contradicts the tier still wins, but logs a WARN.
# # Resource quota per sandbox. 0 = unlimited.
# cpus = 2
# memory_mb = 4096
# disk_mb = 10240                          # Linux + overlay2/xfs only; ignored elsewhere
#
# # Per-tier backend (wins over the global `backend` above)
# [environment.backends]
# local     = "host"
# headless  = "envd"
# desktop   = "docker"

# ---------------------------------------------------------------------------
# Global MCP servers (P2b): non-plugin MCP, independent of plugin enable state.
# Tools are registered as `mcp.<server>.<tool>`; commands relative to this file
# resolve from the config file directory. Edit then reload from the MCP panel
# (or POST /api/mcp/reload); plugin enable is rejected when its MCP server name
# collides with a global one (global wins).
# ---------------------------------------------------------------------------
# [mcp_servers]
# [[mcp_servers.server]]
# name = "demo"
# transport = "stdio"            # stdio | (streamable http 后续支持)
# command = "bin/demo-mcp"       # 相对本配置文件目录
# args = ["serve"]
# env = { TOKEN = "replace-me" }
