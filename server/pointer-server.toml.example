# Copy to pointer-server.toml beside pointer-server.exe (NOT pointer-server.toml.example).
# OS environment variables override file values (remove NSSM AppEnvironmentExtra if duplicated).

# --- Standalone self-hosted deployment (no readflowai.com) ---
# [deployment]
# mode = "standalone"
#
# [auth.local]
# username = "admin"
# hmac_secret = "replace-with-long-random-secret"
# # Generate: pointer-server --hash-password --secret '<hmac_secret>' '<password>'
# password_hmac = "...."
#
# [llm]
# active_provider = "qwen"
# [llm.providers.qwen]
# api_key = "sk-..."
# base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
# name = "千问"
# models = ["qwen3.5-plus"]
#
# [license]
# key = "BASE64_PAYLOAD.BASE64_SIGNATURE"
# # or: license_file = "license.key"
#
# [usage]
# report_enabled = false

[server]
addr = "0.0.0.0:8787"
static_dir = "dist"
# Data dir and logs default to the same paths as the desktop client
# ({data_dir}/PointerApp release, PointerAppDev debug; logs under …/logs/).
# Override data dir only if needed:
# app_data_dir = "/absolute/path"
# Public base URL (no trailing slash) reachable from end-user browsers.
# Used to build the OAuth redirect_uri for the server-side PKCE login flow
# ({public_url}/api/auth/oauth/callback). Also used for IM large-file
# download links: GET /api/media/public-download?token=… (HMAC, no login).
# Add that callback URL to the platform
# env POINTER_APP_REDIRECT_URIS. When omitted, it falls back to
# http://{host}:{port} derived from `addr` — including loopback binds
# (127.0.0.1 / 0.0.0.0 / localhost → http://127.0.0.1:{port}) so local
# development works with zero config. Set this explicitly for production
# behind a public domain or reverse proxy.
# Optional: POINTER_MEDIA_DOWNLOAD_SECRET / POINTER_MEDIA_DOWNLOAD_TTL_SECS
# for signing IM public download tokens (default TTL 7 days).
# public_url = "https://pointer.example.com"
#
# Restrict platform OAuth to specific user ids (platform account id).
# Leave empty to allow any platform user (development / trusted intranet only).
# allowed_user_ids = ["your-platform-user-id"]
# require_allowed_users = true
#
# Auth: pointer-server does NOT write auth.dat. Each browser gets its own
# in-memory OAuth session via the HttpOnly cookie `pointer_web_session`.
# Visitors without that cookie see logged-out state. After upgrading, delete
# any legacy auth.dat under the data dir so old global sessions are not reused
# by the desktop-style code path on other entrypoints.
#
# Standalone mode: Web UI shows username/password + captcha login.
# POST /api/auth/local/login with [auth.local] username / password_hmac / hmac_secret.
# Generate password_hmac: pointer-server --hash-password --secret '<hmac_secret>' '<password>'
# Deprecated: admin_token is ignored.
#
# Conversation history (GET /api/conversations*) requires a logged-in browser
# session. Unauthenticated visitors see an empty sidebar until they sign in.
# The Tauri desktop app is unchanged (local auth.dat + IPC).

[openpointer]
api_base = "https://pointer-api.readflowai.com"
# Must match pointer-official API env THIRD_PARTY_OAUTH_EXCHANGE_SECRET (NOT JWT_SECRET).
oauth_client_secret = "replace-me"

# Optional: any additional env vars (KEY=VALUE)
# [env]
# POINTER_API_BASE = "https://pointer-api.readflowai.com"
