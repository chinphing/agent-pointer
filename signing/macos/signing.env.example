# Copy to signing.env and fill in values:
#   npm run signing:macos:setup
# Or manually:
#   cp signing/macos/signing.env.example signing/macos/signing.env
#
# Find signing identity after importing p12:
#   security find-identity -v -p codesigning
#
# App-specific password (not Apple ID login password):
#   https://appleid.apple.com → Sign-In and Security → App-Specific Passwords

# --- Certificate (.p12) ---
# Absolute path or path relative to pointer-app repo root
APPLE_CERTIFICATE_PATH=../yzt.p12
APPLE_CERTIFICATE_PASSWORD=CHANGE_ME

# Must match "Developer ID Application: ..." from security find-identity
APPLE_SIGNING_IDENTITY=Developer ID Application: CHANGE_ME (TEAMID)
# Optional for sign-only; required for notarization
APPLE_TEAM_ID=CHANGE_ME

# --- Notarization (only required for npm run build:macos:signed) ---
# Sign-only builds (npm run build:macos:sign-only) can leave these empty.

# Method A: Apple ID + app-specific password
# APPLE_ID=your@email.com
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Method B: App Store Connect API key (comment out Method A if using this)
# APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_API_KEY=XXXXXXXXXX
# APPLE_API_KEY_PATH=signing/macos/AuthKey_XXXXXXXXXX.p8

# --- Optional build options ---
# true = use cert already in macOS Keychain (recommended for local builds)
# false = import APPLE_CERTIFICATE_PATH via env on each build (CI)
APPLE_USE_KEYCHAIN=true
# universal | native (default: universal)
MACOS_BUILD_ARCH=universal
