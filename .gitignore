# Per-developer control-plane defaults (see pointer.local.env.example).
pointer.local.env

# quick-deploy local state: pids, logs, data dirs, generated standalone password
.quick-deploy/

# macOS signing: only signing.env.example / README.md are committed;
# real secrets and cert material stay local.
signing/macos/signing.env
signing/macos/*.p12
signing/macos/*.p8
scripts/signing/macos/signing.env

# local runtime logs (do not commit)
logs/
*.log

**/*/__pycache__
*.pyc

# local test/debug scratch (scripts, logs, phoenix.db, venv)
react-check/

# vite / vitest writes a compiled config next to vite.config.ts
vite.config.ts.timestamp-*.mjs

# Nested benchmark repo with its own remote (chinphing/screenspot-pro-bench).
# Keep it as a separate clone, never as files or a gitlink in this repo.
benchmarks/screenspot_grid/

# P0 harness output (screenshots, crops, results.json) — regenerate, do not commit.
cases/

# Scratch UI crops from debugging sessions.
.tmp-ui/

# locate_fixture 的本地 API key（模板是 env.example，见 README）
crates/pointer-core/tests/locate_fixture/.env
