{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pointer",
  "version": "0.1.0",
  "identifier": "com.pointer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pointer · AI 工作台",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "acceptFirstMouse": true,
        "transparent": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "appimage", "dmg"],
    "category": "Productivity",
    "shortDescription": "Pointer AI desktop chat client",
    "longDescription": "Pointer is a cross-platform desktop AI chat client built with Tauri 2 and Vue 3.",
    "copyright": "Copyright © 2026 Pointer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../skills/": "skills/"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "wix": {
        "language": ["en-US", "zh-CN"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
