{
  "name": "agent-pointer",
  "author": "刘新星 (https://ptr.readflowai.com)",
  "homepage": "https://ptr.readflowai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chinphing/agent-pointer.git"
  },
  "bugs": {
    "url": "https://github.com/chinphing/agent-pointer/issues"
  },
  "license": "Apache-2.0",
  "version": "0.1.3-rc3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "node scripts/tauri-build.mjs",
    "admin:dev": "cargo run -p pointer-admin",
    "admin:build": "node scripts/build-admin.mjs",
    "admin:package": "node scripts/build-admin.mjs --package-only",
    "admin:start": "node scripts/pointer-admin-process.mjs start",
    "admin:daemon": "node scripts/pointer-admin-process.mjs start",
    "admin:stop": "node scripts/pointer-admin-process.mjs stop",
    "admin:restart": "node scripts/pointer-admin-process.mjs restart",
    "admin:status": "node scripts/pointer-admin-process.mjs status",
    "server:dev": "cargo run -p pointer-server",
    "server:build": "node scripts/build-server.mjs",
    "server:package": "node scripts/build-server.mjs --package-only",
    "license-gen:dev": "cargo run -p pointer-license-gen --",
    "license-gen:build": "node scripts/build-license-gen.mjs",
    "server:start": "cargo run -p pointer-server --release",
    "server:daemon": "node scripts/pointer-server-process.mjs start",
    "server:stop": "node scripts/pointer-server-process.mjs stop",
    "server:restart": "node scripts/pointer-server-process.mjs restart",
    "server:status": "node scripts/pointer-server-process.mjs status",
    "server:build:deb": "node scripts/build-server.mjs --deb-only",
    "server:build:linux": "npm run server:build",
    "server:deb": "npm run server:build",
    "license-gen:package": "npm run license-gen:build",
    "web:dev": "vite --host 0.0.0.0 --port 1420",
    "icons": "node scripts/generate-app-icons.mjs",
    "build:windows": "node scripts/tauri-build.mjs",
    "build:macos": "node scripts/tauri-build.mjs",
    "build:macos:signed": "node scripts/macos-signed-build.mjs",
    "build:macos:sign-only": "node scripts/macos-signed-build.mjs --sign-only",
    "build:macos:universal": "node scripts/tauri-build.mjs --target universal-apple-darwin",
    "signing:macos:setup": "node scripts/macos-signing-setup.mjs",
    "build:linux": "node scripts/tauri-build.mjs",
    "build:linux:appimage": "node scripts/tauri-build.mjs --bundles appimage",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "licenses": "node scripts/generate-third-party-notices.mjs",
    "docs:install": "npm --prefix docs-site install",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "docs:preview": "npm --prefix docs-site run preview"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.34",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@tauri-apps/plugin-updater": "^2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "abortcontroller-polyfill": "^1.7.8",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.14",
    "js-yaml": "^5.4.1",
    "katex": "^0.19.1",
    "lucide-vue-next": "^0.460.0",
    "marked": "^14.1.3",
    "mermaid": "^12.3.0",
    "pinia": "^2.2.6",
    "resize-observer-polyfill": "^1.5.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-unicode-property-regex": "^7.29.7",
    "@tauri-apps/cli": "^2.1.0",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.0",
    "regexpu-core": "^6.5.4",
    "sharp": "^0.35.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.51.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.14"
  },
  "browserslist": [
    "chrome >= 63"
  ]
}
